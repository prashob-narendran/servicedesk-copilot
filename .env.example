# Copy to .env and fill in. Never commit .env.

# LLM: "groq" = free API key from https://console.groq.com/keys (no card needed); or "openai"
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# Optional model override (defaults: llama-3.1-8b-instant for groq, gpt-4o-mini for openai)
# LLM_MODEL=llama-3.1-8b-instant

# Fine-tuned models: local folders, or your Hugging Face Hub repos after running the Colab notebook
CLASSIFIER_MODEL_ID=models/queue-classifier
PRIORITY_MODEL_ID=models/priority-classifier
# CLASSIFIER_MODEL_ID=<hf-user>/servicedesk-queue-classifier
# PRIORITY_MODEL_ID=<hf-user>/servicedesk-priority-classifier

# Optional: when API_KEY is set, clients must send it in the X-API-Key header
API_KEY=
# true = load all models at start-up instead of on first request
PRELOAD_MODELS=false
# cuda if you have an NVIDIA GPU
DEVICE=cpu
# calibrate with: python -m rag.eval.run_eval --retrieval-only
RAG_SCORE_THRESHOLD=0.5
NER_ENABLED=true

# Streamlit UI
API_URL=http://localhost:8000/api/v1
